{
  "name": "laagarn",
  "private": true,
  "version": "2.0.0",
  "description": "LAAGARN: My Way, Your Travel Buddy. Offline-first, mobile-ready real-time GPS navigation for the Philippines.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run lint && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port=4173 --host=0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts",
    "check": "npm run lint && npm run test && vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
