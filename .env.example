# Wayfarer Atlas works 100% out-of-the-box with no required API keys!
# All endpoints below are optional overrides for enterprise/self-hosted infrastructure.

# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSRM_DRIVING_URL=https://router.project-osrm.org/route/v1/driving
# VITE_OSRM_CYCLING_URL=https://routing.openstreetmap.de/routed-bike/route/v1/bike
# VITE_OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# VITE_WEATHER_URL=https://api.open-meteo.com/v1/forecast
